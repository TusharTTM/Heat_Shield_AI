# Server-only FastAPI configuration. Never expose these values through VITE_* variables.
APP_ENV=development
DATABASE_URL=sqlite:///./heatshield.db
# Production example (URL-encode the password):
# DATABASE_URL=postgresql+psycopg://heatshield:password@localhost:5432/heatshield
CORS_ORIGINS=http://localhost:5173,https://tusharttm.github.io
LOG_LEVEL=INFO
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10
AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
AIR_QUALITY_TIMEOUT_SECONDS=10
WEATHER_CACHE_SECONDS=600

# Optional official CPCB station observations through Open Government Data India.
# Keep the credential server-only. An empty value returns CPCB_NOT_CONFIGURED.
DATA_GOV_IN_API_KEY=
CPCB_BASE_URL=https://api.data.gov.in/resource/3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
CPCB_TIMEOUT_SECONDS=10
CPCB_CACHE_SECONDS=3600

# Optional NDMA SACHET RSS/CAP retrieval. XML and ETags are persisted by the backend.
SACHET_ENABLED=true
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
SACHET_TIMEOUT_SECONDS=12
SACHET_CACHE_SECONDS=300
SACHET_MAX_CAP_DOCUMENTS=50

# Required for sensor ingestion; generate at least 32 random characters.
SENSOR_API_KEY=
SENSOR_STALE_SECONDS=900

# No trained artifact is bundled. Configure only after real training/evaluation.
ML_MODEL_PATH=ml/saved_models/temperature_model.joblib
ML_METADATA_PATH=ml/saved_models/temperature_model.metadata.json

# Required only by compose.yaml's PostgreSQL service.
POSTGRES_PASSWORD=

# The frontend calls Open-Meteo directly and caches responses for ten minutes.
# No frontend credential is required or permitted. For optional official sources,
# configure only the non-secret backend origin in frontend/.env (see frontend/.env.example).
