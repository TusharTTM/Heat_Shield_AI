# Optional non-secret FastAPI origin used only for SACHET CAP and CPCB station panels.
# Leave unset for the standalone GitHub Pages/Open-Meteo deployment.
# Local example: VITE_API_BASE_URL=http://localhost:8000
# Production example: VITE_API_BASE_URL=https://api.example.org
# Never put DATA_GOV_IN_API_KEY, database passwords, sensor keys, or other secrets here.
VITE_API_BASE_URL=
